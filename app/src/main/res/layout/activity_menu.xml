<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="30dp">

    <Button
        android:id="@+id/btn_exp1"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="实验1 ListView动物列表"/>
    <Button
        android:id="@+id/btn_exp2"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="实验2 自定义登录弹窗"/>
    <Button
        android:id="@+id/btn_exp3"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="实验3 弹出菜单"/>
    <Button
        android:id="@+id/btn_exp4"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="实验4 ActionMode"/>
    <Button
        android:id="@+id/btn_exp5"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="实验5 RecyclerView"/>

</LinearLayout>